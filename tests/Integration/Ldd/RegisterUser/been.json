                        "inject": {
                            "verifier": "MyVendor\\MyApp\\Ldd\\RegisterUser\\EmailVerifier",
                            "users": "MyVendor\\MyApp\\Ldd\\RegisterUser\\UserRepository",
                            "been": "Be\\Framework\\SemanticLog\\Been"
                        }
                    },
                    "children": [
                        {
                            "kind": "event",
                            "id": "email_format_asserted_1",
                            "type": "email_format_asserted",
